def ft_transpose3d(image: list) -> list:
    """
    Transpose a 3D list (swap height and width axes).
    """
    h, w, c = len(image), len(image[0]), len(image[0][0])
    return [[[image[y][x][ch] for ch in range(c)] for y in range(h)]
            for x in range(w)]


def main():
